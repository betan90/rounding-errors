---
// Built from the repo itself: scripts/lib/inventory.mjs discovers the tools,
// src/data/methodology.mjs says what each is for, and
// scripts/check-methodology.mjs fails the build when the 2 disagree.
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
import { discover, modelHistory, servedModels, toolingTimeline, assertFullHistory } from '../../scripts/lib/inventory.mjs';
import { REPO, entries, pipeline, external, offRepo, eras, noneYet } from '../data/methodology.mjs';

assertFullHistory();

const tools = discover();
const byKind = (k: string) => tools.filter((t: any) => t.kind === k);
const nameOf = (id: string) => tools.find((t: any) => t.id === id)?.name ?? id;
const fileUrl = (f: string) => `${REPO}/blob/main/${f}`;
const commitUrl = (h: string) => `${REPO}/commit/${h}`;

const none: Record<string, string> = noneYet;
const desc: Record<string, { role: string; why: string }> = entries;
const models = modelHistory();
const timeline = toolingTimeline();

// What actually ran, per agent, model and effort, and per exhibit, from the
// model log. Comparison runs (scripts/compare-drafts.mjs) are left out: they
// made no exhibit.
const logged: any[] = servedModels();
const runs = logged.filter((r) => !r.comparison);
const comparisons = logged.length - runs.length;
const servedFirst = runs[0]?.date;
const at = (r: any) => (r.effort?.length ? `at ${r.effort.join(', then ')}` : 'with no effort setting');
const served = Object.values(
  runs.reduce((acc: Record<string, any>, r: any) => {
    for (const model of r.models) {
      const g = (acc[`${r.agent} ${model} ${at(r)}`] ??= { agent: r.agent, model, at: at(r), n: 0, from: r.date, to: r.date, requested: 0 });
      g.n += 1;
      g.to = r.date;
      if (r.requested || r.requestedEffort) g.requested += 1;
    }
    return acc;
  }, {}),
).sort((a: any, b: any) => a.agent.localeCompare(b.agent) || a.from.localeCompare(b.from));
const latestServed = (agent: string) => runs.filter((r) => r.agent === agent).at(-1);
const byExhibit = Object.entries(
  runs.reduce((acc: Record<string, Record<string, number>>, r: any) => {
    if (!r.exhibit) return acc;
    for (const model of r.models) {
      const k = `${r.agent} on ${model} ${at(r)}`;
      (acc[r.exhibit] ??= {})[k] = ((acc[r.exhibit] ??= {})[k] ?? 0) + 1;
    }
    return acc;
  }, {}),
).sort(([a], [b]) => b.localeCompare(a));

// Rendered in this order. A kind with no tools shows its noneYet line, so
// "no custom skills" is stated rather than implied.
const sections: Array<{ kind: string; title: string }> = [
  { kind: 'agent', title: 'Agents' },
  { kind: 'hook', title: 'Hooks' },
  { kind: 'skill', title: 'Skills' },
  { kind: 'command', title: 'Slash commands' },
  { kind: 'mcp', title: 'MCP servers' },
  { kind: 'plugin', title: 'Plugins' },
  { kind: 'script', title: 'Scripts' },
  { kind: 'workflow', title: 'Workflows' },
  { kind: 'dependency', title: 'Dependencies' },
];

const counts = sections
  .map((s) => ({ ...s, n: byKind(s.kind).length }))
  .filter((s) => s.n > 0)
  .map((s) => `${s.n} ${s.n === 1 ? s.title.toLowerCase().replace(/s$/, '') : s.title.toLowerCase()}`);

function facts(t: any): Array<[string, string]> {
  switch (t.kind) {
    case 'agent': {
      const last = latestServed(t.name);
      return [
        ['Model', t.model],
        ...(last ? [['Last served', `${last.models.join(', ')} ${at(last)} on ${last.date}`] as [string, string]] : []),
        ['Tools', t.tools.join(', ')],
      ];
    }
    case 'hook':
      return [['Fires on', `${t.event}, ${t.matcher}`], ['Runs', t.command]];
    case 'script':
      return t.npm.length ? [['npm', t.npm.join(', ')]] : [];
    case 'workflow':
      return [['Trigger', t.triggers.join(', ')], ['Actions', t.actions.join(', ')]];
    case 'dependency':
      return [['Version', `${t.version}${t.dev ? ' (dev)' : ''}`]];
    default:
      return [];
  }
}
---

<BaseLayout
  title="Methodology · Rounding Errors"
  description="Every tool, model and check behind the museum, read from the repo at build time."
>
  <div class="listing-head">
    <div class="kicker">The method</div>
    <h1>How this is made</h1>
  </div>
  <p class="corrections-framing">
    This page is built from the files it describes. The tools, their models and their history are read from the repo when the site builds. A tool the repo uses but this page doesn't describe fails the build.
  </p>
  <p class="method-counts">{counts.join(' · ')}</p>

  <h2 class="method-h">The pipeline</h2>
  <ol class="method-pipeline">
    {
      pipeline.map((s) => (
        <li>
          <b>{s.step}.</b> {s.text}
          {s.uses.length > 0 && <span class="method-uses">{s.uses.map(nameOf).join(' · ')}</span>}
        </li>
      ))
    }
  </ol>

  {
    sections.map((s) => {
      const items = byKind(s.kind);
      if (!items.length && !none[s.kind]) return null;
      return (
        <section>
          <h2 class="method-h">{s.title}</h2>
          {items.length === 0 ? (
            <p class="method-none">{none[s.kind]}</p>
          ) : (
            items.map((t: any) => {
              const e = desc[t.id];
              return (
                <article class="correction method-item">
                  <div class="correction-head">
                    <span><b>{t.name}</b></span>
                    <a class="inline" href={fileUrl(t.file)}>{t.file}</a>
                  </div>
                  <dl class="correction-body">
                    {facts(t).map(([k, v]) => (
                      <div class="correction-row">
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                    <div class="correction-row">
                      <dt>What it does</dt>
                      <dd>{e.role}</dd>
                    </div>
                    <div class="correction-row">
                      <dt>Why</dt>
                      <dd>{e.why}</dd>
                    </div>
                  </dl>
                </article>
              );
            })
          )}
        </section>
      );
    })
  }

  <h2 class="method-h">Outside the repo, checked</h2>
  <p class="method-none">Services and programs the repo depends on. Each claim below names a file that must still say so, or the build fails.</p>
  <dl class="correction-body method-list">
    {
      external.map((x) => (
        <div class="correction-row">
          <dt>{x.name}</dt>
          <dd>
            {x.role}{' '}
            <a class="inline" href={fileUrl(x.receipt.file)}>{x.receipt.file}</a>
          </dd>
        </div>
      ))
    }
  </dl>

  <h2 class="method-h">Outside the repo, not replicable from it</h2>
  <dl class="correction-body method-list">
    {
      offRepo.map((x) => (
        <div class="correction-row">
          <dt>{x.name}</dt>
          <dd>{x.role}</dd>
        </div>
      ))
    }
  </dl>

  <h2 class="method-h">Model history</h2>
  <p class="method-none">Every change to an agent's model line, from git.</p>
  <dl class="correction-body method-list">
    {
      models.map((m: any) => (
        <div class="correction-row">
          <dt>
            {m.date} · <a class="inline" href={commitUrl(m.hash)}>{m.hash}</a>
          </dt>
          <dd>
            {m.agent}: {m.from ? `${m.from} → ${m.to}` : `set to ${m.to}`}
          </dd>
        </div>
      ))
    }
  </dl>

  <h2 class="method-h">Models that actually ran</h2>
  <p class="method-none">
    An agent file names a model family and no effort level. The family follows its newest model without a commit, and the effort follows whatever the session running the agents is set to, even partway through a run. This is the model the API served and the effort each turn ran at, copied from Claude Code's transcripts each time an agent finishes, into <a class="inline" href={fileUrl('reports/model-log.jsonl')}>reports/model-log.jsonl</a>. {runs.length} runs since {servedFirst}; transcripts from before then had already been deleted.{comparisons > 0 && ` ${comparisons} comparison runs, which drafted nothing that shipped, are logged too and left out here.`}
  </p>
  <dl class="correction-body method-list">
    {
      served.map((g: any) => (
        <div class="correction-row">
          <dt>{g.agent}</dt>
          <dd>
            {g.model} {g.at}: {g.n} {g.n === 1 ? 'run' : 'runs'}, {g.from === g.to ? g.from : `${g.from} to ${g.to}`}
            {g.requested > 0 && <span class="method-uses">{g.requested} of these named the model or effort when launched, which overrides the agent file and the session.</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  <dl class="correction-body method-list">
    {
      byExhibit.map(([exhibit, counts]) => (
        <div class="correction-row">
          <dt>Exhibit {exhibit}</dt>
          <dd>{Object.entries(counts).map(([k, n]) => (n > 1 ? `${k} ×${n}` : k)).join(' · ')}</dd>
        </div>
      ))
    }
  </dl>

  <h2 class="method-h">How it got here</h2>
  <p class="method-none">
    Each row is a change to how exhibits get made, oldest first, with the commits that made it. A new tool is tried on 1 exhibit, then kept or dropped; either way it gets a row here, in the commit straight after the change, because the row cites that change's commit. The build fails if a listed commit doesn't exist or the rows are out of order.
  </p>
  <dl class="correction-body method-list">
    {
      eras.map((e: any, i: number) => (
        <div class="correction-row">
          <dt>
            {i + 1}. {e.name}
          </dt>
          <dd>
            {e.changed} {e.why}
            {e.selfReported && <span class="method-uses">Self-reported. {e.selfReported}</span>}
            {e.commits.length > 0 && (
              <span class="method-uses">
                {e.commits.map((h: string, j: number) => (
                  <>
                    {j > 0 && ' · '}
                    <a class="inline" href={commitUrl(h)}>{h}</a>
                  </>
                ))}
              </span>
            )}
            {e.note && (
              <span class="method-uses">
                <a class="inline" href={withBase(`/notes/${e.note}/`)}>The longer story</a>
              </span>
            )}
          </dd>
        </div>
      ))
    }
  </dl>

  <h2 class="method-h">Changelog</h2>
  <p class="method-none">
    Every commit that touched the house rules, the agents, the hooks, the scripts, the workflows or the dependencies, newest first. {timeline.length} so far.
  </p>
  <dl class="correction-body method-list">
    {
      timeline.map((c: any) => (
        <div class="correction-row">
          <dt>
            {c.date} · <a class="inline" href={commitUrl(c.hash)}>{c.hash}</a>
          </dt>
          <dd>
            {c.subject}
            <span class="method-uses">{c.files.join(' · ')}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <p class="method-none method-foot">
    To replicate the setup, start from <a class="inline" href={fileUrl('CLAUDE.md')}>CLAUDE.md</a> and the agent files above. Source: <a class="inline" href={REPO}>{REPO.replace('https://', '')}</a>.
  </p>
</BaseLayout>
