---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitCard from '../components/ExhibitCard.astro';
import { withBase } from '../lib/paths';
import { sortExhibits } from '../lib/sortExhibits';

const exhibits = sortExhibits(await getCollection('exhibits'));
---

<BaseLayout title="Rounding Errors · A museum of statistical discrepancies">
  <div class="feed">
    {
      exhibits.map((entry) => (
        <ExhibitCard
          exhibit={entry.data.exhibit}
          country={entry.data.country}
          title={entry.data.title}
          category={entry.data.category}
          teaser={entry.data.teaser}
          date={entry.data.date}
          href={withBase(`/exhibits/${entry.slug}/`)}
        />
      ))
    }
  </div>
</BaseLayout>
