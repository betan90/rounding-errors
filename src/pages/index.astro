---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ExhibitCard from '../components/ExhibitCard.astro';
import NoteCard from '../components/NoteCard.astro';
import { withBase } from '../lib/paths';
import { sortExhibits } from '../lib/sortExhibits';

const exhibits = sortExhibits(await getCollection('exhibits'));
const notes = (await getCollection('notes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const noteNumber = (slug: string) => slug.split('-')[0];

// One feed, newest first: the 2 sorted lists merged by date. On the same day
// the exhibit comes first, and exhibits keep sortExhibits' order among themselves.
const feed: Array<{ kind: 'exhibit'; entry: (typeof exhibits)[number] } | { kind: 'note'; entry: (typeof notes)[number] }> = [];
for (let i = 0, j = 0; i < exhibits.length || j < notes.length; ) {
  const e = exhibits[i];
  const n = notes[j];
  if (n && (!e || n.data.date.valueOf() > e.data.date.valueOf())) feed.push({ kind: 'note', entry: notes[j++] });
  else feed.push({ kind: 'exhibit', entry: exhibits[i++] });
}
---

<BaseLayout title="Rounding Errors · A museum of statistical discrepancies">
  <div class="feed">
    {
      feed.map((item) =>
        item.kind === 'exhibit' ? (
          <ExhibitCard
            exhibit={item.entry.data.exhibit}
            country={item.entry.data.country}
            title={item.entry.data.title}
            category={item.entry.data.category}
            teaser={item.entry.data.teaser}
            date={item.entry.data.date}
            href={withBase(`/exhibits/${item.entry.slug}/`)}
          />
        ) : (
          <NoteCard
            number={noteNumber(item.entry.slug)}
            title={item.entry.data.title}
            teaser={item.entry.data.teaser}
            date={item.entry.data.date}
            href={withBase(`/notes/${item.entry.slug}/`)}
          />
        )
      )
    }
  </div>
</BaseLayout>
