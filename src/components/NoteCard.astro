---
interface Props {
  number?: string;
  title: string;
  teaser: string;
  date: Date;
  href: string;
}

const { number, title, teaser, date, href } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a class="card" href={href}>
  <div class="card-filing">
    <span>Note{number && <> <b>{number}</b></>}</span>
    <span>Behind the scenes</span>
  </div>
  <h2 class="card-title">{title}</h2>
  <p class="card-teaser">{teaser}</p>
  <div class="card-date">{formattedDate}</div>
</a>
