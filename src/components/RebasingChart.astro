---
---

<div class="chart-block">
  <div class="legend">
    <span><i class="swatch" style="background:var(--red-line)"></i> Reported before rebasing (Mar 2014)</span>
    <span><i class="swatch" style="background:var(--ink)"></i> Reported after rebasing (Apr 2014)</span>
    <span><i class="swatch" style="background:var(--ink-soft)"></i> South Africa, 2013 GDP (comparison)</span>
  </div>
  <figure>
    <svg
      id="chart"
      viewBox="0 0 760 470"
      role="img"
      aria-label="Bar chart of Nigeria's 2013 GDP as reported before and after the April 2014 rebasing. The before bar shows 285.6 billion dollars. The after bar shows 509.9 billion dollars, an 89.2 percent increase, bracketed and labeled between the two bars. A dashed horizontal reference line marks South Africa's 2013 GDP of about 354 billion dollars. A note states both bars describe the same already-finished 2013 calendar year, with no change to the underlying economy."
    ></svg>
    <figcaption class="cap">Same year, same country, same economy. The one on the right uses a base year from 2010 instead of 1990.</figcaption>
  </figure>
</div>

<script is:inline>
(function(){
  // ---- DATA ----
  // Before/after figures and the 89.2% increase: African Development Bank press
  //   release, "Nigeria Becomes Largest Economy in Africa, with $509.9 Billion GDP"
  //   (4 April 2014): 2013 GDP $285.56bn (pre-rebasing) to $509.9bn (post-rebasing).
  //   The 89.2% figure is the Bank's own, calculated in naira before conversion;
  //   it does not equal the naive percent change between the two dollar figures
  //   shown here, because the two dollar conversions used different exchange rates.
  // South Africa comparator: Oxford Business Group, "Questions raised by Nigeria's
  //   recalibrated GDP figures" (2015): South Africa's 2013 GDP, approximately $354bn.
  var before = 285.56;
  var after = 509.9;
  var increasePct = '+89.2%';
  var southAfrica = 354;

  var W=760, H=470, m={t:40,r:60,b:80,l:60};
  var pw=W-m.l-m.r, ph=H-m.t-m.b;
  var yMax=750;
  function Y(v){return m.t + (1-v/yMax)*ph;}

  var svg=document.getElementById('chart');
  var NS='http://www.w3.org/2000/svg';
  function el(t,a){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);return e;}

  // gridlines + y labels
  for(var g=0; g<=600; g+=100){
    svg.appendChild(el('line',{x1:m.l,y1:Y(g),x2:W-m.r,y2:Y(g),stroke:'#C6C7BF','stroke-width':1}));
    var yl=el('text',{x:m.l-8,y:Y(g)+4,'text-anchor':'end','font-family':"'IBM Plex Mono',monospace",'font-size':11,fill:'#5A5C55'});
    yl.textContent=g; svg.appendChild(yl);
  }
  // y axis title
  var yt=el('text',{x:m.l-8,y:Y(600)-8,'text-anchor':'end','font-family':"'IBM Plex Mono',monospace",'font-size':10.5,fill:'#5A5C55'});
  yt.textContent='$bn'; svg.appendChild(yt);

  // bar geometry
  var c1 = m.l + pw*0.28;
  var c2 = m.l + pw*0.72;
  var barWidth = 140;
  var base = Y(0);

  // before bar (red)
  var y1 = Y(before);
  svg.appendChild(el('rect',{x:c1-barWidth/2,y:y1,width:barWidth,height:base-y1,fill:'#C22B24',class:'fade'}));
  var v1=el('text',{x:c1,y:y1-10,'text-anchor':'middle','font-family':"'IBM Plex Mono',monospace",'font-size':15,'font-weight':700,fill:'#C22B24'});
  v1.textContent='$285.6bn'; svg.appendChild(v1);
  var l1=el('text',{x:c1,y:H-m.b+22,'text-anchor':'middle','font-family':"'IBM Plex Mono',monospace",'font-size':11,fill:'#5A5C55'});
  l1.textContent='BEFORE, MARCH 2014'; svg.appendChild(l1);

  // after bar (ink)
  var y2 = Y(after);
  svg.appendChild(el('rect',{x:c2-barWidth/2,y:y2,width:barWidth,height:base-y2,fill:'#17181A',class:'fade'}));
  var v2=el('text',{x:c2,y:y2-10,'text-anchor':'middle','font-family':"'IBM Plex Mono',monospace",'font-size':15,'font-weight':700,fill:'#17181A'});
  v2.textContent='$509.9bn'; svg.appendChild(v2);
  var l2=el('text',{x:c2,y:H-m.b+22,'text-anchor':'middle','font-family':"'IBM Plex Mono',monospace",'font-size':11,fill:'#5A5C55'});
  l2.textContent='AFTER, APRIL 2014'; svg.appendChild(l2);

  // ---- bracket + increase label, between bar tops ----
  var bracketY = Y(600) + 4;
  var bd = 'M '+c1+' '+(y1-28)+' L '+c1+' '+bracketY+' L '+c2+' '+bracketY+' L '+c2+' '+(y2-28);
  svg.appendChild(el('path',{d:bd,fill:'none',stroke:'#5A5C55','stroke-width':1.25,class:'fade'}));
  var incLabel=el('text',{x:(c1+c2)/2,y:bracketY-10,'text-anchor':'middle','font-family':"'IBM Plex Mono',monospace",'font-size':16,'font-weight':700,fill:'#17181A'});
  incLabel.textContent=increasePct; svg.appendChild(incLabel);

  // ---- South Africa reference line ----
  var ys=Y(southAfrica);
  svg.appendChild(el('line',{x1:m.l,y1:ys,x2:W-m.r,y2:ys,stroke:'#5A5C55','stroke-width':1.5,'stroke-dasharray':'6,5'}));
  var sal=el('text',{x:W-m.r,y:ys-8,'text-anchor':'end','font-family':"'IBM Plex Mono',monospace",'font-size':11,'font-weight':700,fill:'#5A5C55'});
  sal.textContent='SOUTH AFRICA, 2013: ~$354BN'; svg.appendChild(sal);

  // ---- annotation: same year, same economy ----
  var an1=el('text',{x:m.l,y:H-m.b+42,'text-anchor':'start','font-family':"'IBM Plex Mono',monospace",'font-size':10.5,fill:'#5A5C55'});
  an1.textContent='BOTH BARS: FISCAL YEAR 2013, ALREADY CLOSED WHEN REVISED.'; svg.appendChild(an1);
  var an2=el('text',{x:m.l,y:H-m.b+58,'text-anchor':'start','font-family':"'IBM Plex Mono',monospace",'font-size':10.5,fill:'#5A5C55'});
  an2.textContent='NO CHANGE TO THE UNDERLYING ECONOMY BETWEEN THEM.'; svg.appendChild(an2);
})();
</script>
