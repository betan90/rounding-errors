---

<div class="chart-block">
  <div class="legend">
    <span><i class="swatch" style="background:var(--red-line)"></i> Cases by publish date, as reported each day</span>
    <span><i class="swatch" style="background:var(--ink)"></i> The same cases by specimen date, as later revised</span>
  </div>
  <figure>
    <svg
      id="chart"
      viewBox="0 0 760 400"
      role="img"
      aria-label="Two-line chart of daily new COVID-19 cases in England, 18 September to 11 October 2020. By publish date, as reported each day, cases run between about 3,300 and 5,700 until 2 October, then jump to 10,806 on 3 October and 21,309 on 4 October, and stay between about 10,400 and 15,000 afterwards. By specimen date, as later revised, cases rise steadily from 4,290 on 18 September to a peak of 15,452 on 8 October, with no jump on 3 or 4 October (9,820 and 9,966). A grey band marks 25 September to 2 October, the dates PHE gave for the affected results. A red band marks 3 and 4 October, labeled backlog added."
    ></svg>
    <figcaption class="cap">The 2 lines are the same cases dated 2 ways. By publish date, the backlog lands on 3 and 4 October. By specimen date, it sits on the days the tests were taken. The 2 series are not like-for-like counts: one is as first published, the other as later revised. England only.</figcaption>
  </figure>
</div>

<script is:inline>
(function(){
  // ---- DATA ----
  // England (area_code E92000001), daily new COVID-19 cases, 18 Sep to 11 Oct 2020 (24 days).
  // Source: UKHSA, COVID-19 Archive data download
  //   (https://ukhsa-dashboard.data.gov.uk/covid-19-archive-data-download),
  //   archive of the decommissioned coronavirus.data.gov.uk dashboard, cases.zip,
  //   files Cases/nation_newCasesByPublishDate.csv and Cases/nation_newCasesBySpecimenDate.csv,
  //   downloaded 10 Oct 2026. UKHSA caveat: the archive has not been fully validated
  //   against the dashboard as last published.
  // Series are not like-for-like: publish date is as first published each day,
  // specimen date is as later revised. Series stop at 11 Oct 2020 by design.
  var pub = [3771,3638,3279,3754,4187,5083,5632,5723,4639,4800,3316,5651,5656,5589,4797,10806,21309,10685,12648,11528,14952,10772,12628,10383];
  var spec = [4290,4215,4652,4727,5400,5933,6361,6105,5704,6084,8641,8832,10663,11444,11719,9820,9966,14218,14458,15418,15452,13159,10301,9781];
  // index 0 = 18 Sep 2020; 7 = 25 Sep; 14 = 2 Oct; 15 = 3 Oct; 16 = 4 Oct; 23 = 11 Oct
  var labels = {0:'18 SEP',7:'25 SEP',14:'2 OCT',23:'11 OCT'}; // 3 and 4 Oct are named by the band label above

  var INK='#17181A', SOFT='#5A5C55', RED='#C22B24', PAPER='#FBF9F4';
  var MONO="'IBM Plex Mono',monospace";

  var W=760, H=400, m={t:48,r:24,b:56,l:56};
  var pw=W-m.l-m.r, ph=H-m.t-m.b;
  var yMax=24000, n=pub.length;
  function X(i){return m.l + (i/(n-1))*pw;}
  function Y(v){return m.t + (1 - v/yMax)*ph;}

  var svg=document.getElementById('chart');
  var NS='http://www.w3.org/2000/svg';
  function el(t,a){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);return e;}
  function text(x,y,s,o){
    o=o||{};
    var e=el('text',{x:x,y:y,'text-anchor':o.anchor||'start','font-family':MONO,
                     'font-size':o.size||11,fill:o.fill||SOFT});
    if(o.weight) e.setAttribute('font-weight',o.weight);
    if(o.spacing) e.setAttribute('letter-spacing',o.spacing);
    e.textContent=s; svg.appendChild(e); return e;
  }
  function path(arr,color){
    var d='M'+arr.map(function(v,i){return X(i)+' '+Y(v);}).join(' L ');
    svg.appendChild(el('path',{d:d,fill:'none',stroke:color,'stroke-width':2.5,
                               'stroke-linejoin':'round','stroke-linecap':'round'}));
  }

  // ---- PHE affected window, 25 Sep to 2 Oct ----
  svg.appendChild(el('rect',{x:X(7),y:m.t,width:X(14)-X(7),height:ph,fill:SOFT,'fill-opacity':0.12}));
  text((X(7)+X(14))/2,m.t-30,'PHE: AFFECTED RESULTS',{anchor:'middle',size:10,spacing:'0.06em'});
  text((X(7)+X(14))/2,m.t-17,'25 SEP TO 2 OCT',{anchor:'middle',size:10,spacing:'0.06em'});

  // ---- backlog added, 3 and 4 Oct on the publish-date line ----
  svg.appendChild(el('rect',{x:X(15)-6,y:m.t,width:X(16)-X(15)+12,height:ph,fill:RED,'fill-opacity':0.14}));
  text(X(16)+14,m.t-17,'3-4 OCT: BACKLOG ADDED',{anchor:'start',size:10,spacing:'0.06em',fill:RED,weight:700});

  // ---- gridlines ----
  for(var g=0; g<=20000; g+=5000){
    svg.appendChild(el('line',{x1:m.l,y1:Y(g),x2:W-m.r,y2:Y(g),stroke:SOFT,'stroke-width':1,
                               'stroke-opacity':g===0?0.55:0.14}));
    text(m.l-8,Y(g)+4,g.toLocaleString('en-GB'),{anchor:'end'});
  }
  text(m.l-8,Y(24000)+4,'cases',{anchor:'end',size:10.5});

  // ---- x labels ----
  for(var k in labels){
    var i=+k;
    svg.appendChild(el('line',{x1:X(i),y1:Y(0),x2:X(i),y2:Y(0)+5,stroke:SOFT,'stroke-width':1}));
    text(X(i),H-m.b+20,labels[k],{anchor:'middle',size:10.5});
  }

  // ---- lines ----
  path(spec,INK);
  path(pub,RED);

  // ---- value labels on the backlog days ----
  svg.appendChild(el('circle',{cx:X(15),cy:Y(pub[15]),r:4,fill:RED}));
  svg.appendChild(el('circle',{cx:X(16),cy:Y(pub[16]),r:4,fill:RED}));
  // Paper-coloured halo so a label stays legible where a line crosses it.
  function halo(e){e.setAttribute('stroke',PAPER);e.setAttribute('stroke-width','4');e.setAttribute('paint-order','stroke');e.setAttribute('stroke-linejoin','round');}
  halo(text(X(15)-8,Y(pub[15])-8,'10,806',{anchor:'end',size:12,weight:700,fill:RED}));
  halo(text(X(16)+10,Y(pub[16])+4,'21,309',{anchor:'start',size:12,weight:700,fill:RED}));
  svg.appendChild(el('circle',{cx:X(15),cy:Y(spec[15]),r:3.5,fill:PAPER,stroke:INK,'stroke-width':2}));
  svg.appendChild(el('circle',{cx:X(16),cy:Y(spec[16]),r:3.5,fill:PAPER,stroke:INK,'stroke-width':2}));
  halo(text(X(15)-8,Y(spec[15])+22,'9,820',{anchor:'end',size:11,fill:INK}));
  halo(text(X(16)+4,Y(spec[16])+20,'9,966',{anchor:'start',size:11,fill:INK}));

  // baseline + title
  svg.appendChild(el('line',{x1:m.l,y1:Y(0),x2:W-m.r,y2:Y(0),stroke:SOFT,'stroke-width':1}));
  text((m.l+W-m.r)/2,H-8,'ENGLAND, DAILY NEW COVID-19 CASES, 18 SEP TO 11 OCT 2020',
       {anchor:'middle',size:10.5,spacing:'0.06em'});
})();
</script>
