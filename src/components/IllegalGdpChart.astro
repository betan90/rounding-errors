<div class="chart-block">
  <div class="legend">
    <span><i class="swatch" style="background:var(--ink)"></i> Series MNC8, prostitution, household final consumption expenditure</span>
    <span><i class="swatch" style="background:var(--red-line)"></i> 2010 figure in the ONS freedom of information reply</span>
  </div>
  <figure>
    <svg
      id="chart"
      viewBox="0 0 760 450"
      role="img"
      aria-label="Line chart of ONS series MNC8, household final consumption expenditure on prostitution, United Kingdom, current prices, 1985 to 2024, in millions of pounds, with 40 annual data points. The series rises from 1,078 in 1985 to 4,370 in 2010 and 5,993 in 2019, falls to 4,130 in 2020, then rises to 6,431 in 2024. A dashed marker at 2014 shows the first estimates entering the UK accounts, on 30 September 2014; values before 2014 are back-cast. A separate red point at 5,600 in 2010 shows the figure given in an ONS freedom of information reply of November 2015, which is 1,230 above the series value for 2010."
    ></svg>
    <figcaption class="cap">The series is modelled, not observed. ONS published its method on 29 May 2014, and the first estimates entered the accounts on 30 September 2014. Values before 2014 are back-cast, and the series has been adjusted since, including the Blue Book 2016 holiday factor. The red point is the 2010 figure from an ONS freedom of information reply, £5.6bn, shown as given and not joined to the line. Source: ONS, series MNC8, released 31 October 2025.</figcaption>
  </figure>
</div>

<script is:inline>
(function(){
  // ---- DATA ----
  // Source: ONS, time series MNC8, "12.2 Prostitution CP NSA £m", dataset BB,
  //   household final consumption expenditure on prostitution, current prices,
  //   £ million, annual, 1985 to 2024. Released 31 October 2025.
  //   https://www.ons.gov.uk/economy/nationalaccounts/satelliteaccounts/timeseries/mnc8/bb
  // 40 points, as published. Nothing is interpolated, rounded or filled.
  var mnc8 = [
    [1985,1078],[1986,1136],[1987,1200],[1988,1290],[1989,1409],[1990,1532],[1991,1665],
    [1992,1740],[1993,1793],[1994,1828],[1995,1894],[1996,1971],[1997,2079],[1998,2193],
    [1999,2360],[2000,2538],[2001,2733],[2002,2915],[2003,3107],[2004,3302],[2005,3483],
    [2006,3677],[2007,3901],[2008,4107],[2009,4227],[2010,4370],[2011,4491],[2012,4635],
    [2013,4761],[2014,4888],[2015,5046],[2016,5329],[2017,5540],[2018,5703],[2019,5993],
    [2020,4130],[2021,4913],[2022,6142],[2023,6252],[2024,6431]
  ];
  // Separate point, not part of the series. Source: ONS freedom of information
  //   response "Illegal Production (N2)", released 6 November 2015: prostitution
  //   in COICOP 12.2, "The value for 2010 is £5.6bn (current prices)".
  //   https://www.ons.gov.uk/aboutus/transparencyandgovernance/freedomofinformationfoi/illegalproductionn2
  var foi = [2010, 5600];

  var INK='#17181A', SOFT='#5A5C55', RED='#C22B24', PAPER='#FBF9F4';
  var MONO="'IBM Plex Mono',monospace";

  var W=760, H=450, m={t:64,r:24,b:62,l:60};
  var pw=W-m.l-m.r, ph=H-m.t-m.b;
  var yMax=7000, x0=1985, x1=2024;
  function X(yr){return m.l + ((yr-x0)/(x1-x0))*pw;}
  function Y(v){return m.t + (1 - v/yMax)*ph;}

  var svg=document.getElementById('chart');
  var NS='http://www.w3.org/2000/svg';
  function el(t,a){var e=document.createElementNS(NS,t);for(var k in a)e.setAttribute(k,a[k]);return e;}
  function text(x,y,s,o){
    o=o||{};
    var e=el('text',{x:x,y:y,'text-anchor':o.anchor||'start','font-family':MONO,
                     'font-size':o.size||11,fill:o.fill||SOFT});
    if(o.weight) e.setAttribute('font-weight',o.weight);
    if(o.spacing) e.setAttribute('letter-spacing',o.spacing);
    e.textContent=s; svg.appendChild(e); return e;
  }
  function halo(e){e.setAttribute('stroke',PAPER);e.setAttribute('stroke-width','4');e.setAttribute('paint-order','stroke');e.setAttribute('stroke-linejoin','round');}
  function fmt(n){return String(n).replace(/\B(?=(\d{3})+(?!\d))/g,',');}

  // ---- gridlines + y labels ----
  for(var g=0; g<=7000; g+=1000){
    svg.appendChild(el('line',{x1:m.l,y1:Y(g),x2:W-m.r,y2:Y(g),stroke:SOFT,'stroke-width':1,
                               'stroke-opacity':g===0?0.55:0.14}));
    text(m.l-8,Y(g)+4,fmt(g),{anchor:'end'});
  }
  text(4,Y(7000)-14,'£ million, current prices',{anchor:'start',size:10.5});

  // ---- x labels ----
  [1985,1990,1995,2000,2005,2010,2015,2020,2024].forEach(function(yr){
    svg.appendChild(el('line',{x1:X(yr),y1:Y(0),x2:X(yr),y2:Y(0)+5,stroke:SOFT,'stroke-width':1}));
    text(X(yr),Y(0)+20,yr,{anchor:'middle',size:10.5});
  });

  // ---- 2014 marker ----
  svg.appendChild(el('line',{x1:X(2014),y1:m.t-30,x2:X(2014),y2:Y(0),stroke:SOFT,'stroke-width':1,
                             'stroke-dasharray':'3 3','stroke-opacity':0.7}));
  text(X(2014)-5,m.t-34,'2014: FIRST ESTIMATES IN THE ACCOUNTS (30 SEP 2014)',
       {anchor:'end',size:10,spacing:'0.04em'});
  text(X(2014)-5,m.t-21,'EARLIER YEARS ARE BACK-CAST',
       {anchor:'end',size:10,spacing:'0.04em'});

  // ---- series ----
  var d='M'+mnc8.map(function(p){return X(p[0])+' '+Y(p[1]);}).join(' L ');
  svg.appendChild(el('path',{d:d,fill:'none',stroke:INK,'stroke-width':2.5,
                             'stroke-linejoin':'round','stroke-linecap':'round'}));
  mnc8.forEach(function(p){
    svg.appendChild(el('circle',{cx:X(p[0]),cy:Y(p[1]),r:2.6,fill:INK,'class':'pt-mnc8'}));
  });

  // ---- FOI point, separate from the line ----
  svg.appendChild(el('line',{x1:X(foi[0]),y1:Y(4370)-4,x2:X(foi[0]),y2:Y(foi[1])+5,stroke:RED,
                             'stroke-width':1,'stroke-dasharray':'2 3','stroke-opacity':0.8}));
  svg.appendChild(el('circle',{cx:X(foi[0]),cy:Y(foi[1]),r:4.2,fill:PAPER,stroke:RED,
                               'stroke-width':2,'class':'pt-foi'}));
  halo(text(X(foi[0])-9,Y(foi[1])-12,'£5.6bn, ONS FOI reply, Nov 2015',
            {anchor:'end',size:11,fill:RED,weight:700}));

  // ---- value labels ----
  halo(text(X(2010)+8,Y(4370)+18,'4,370',{anchor:'start',size:11,fill:INK,weight:700}));
  halo(text(X(2019),Y(5993)-10,'5,993',{anchor:'middle',size:11,fill:INK,weight:700}));
  halo(text(X(2020),Y(4130)+19,'4,130',{anchor:'middle',size:11,fill:INK,weight:700}));
  halo(text(X(2024),Y(6431)-10,'6,431',{anchor:'end',size:11,fill:INK,weight:700}));

  // baseline + title
  svg.appendChild(el('line',{x1:m.l,y1:Y(0),x2:W-m.r,y2:Y(0),stroke:SOFT,'stroke-width':1}));
  text((m.l+W-m.r)/2,H-26,'UNITED KINGDOM, 1985 TO 2024',
       {anchor:'middle',size:10.5,spacing:'0.06em'});
  text((m.l+W-m.r)/2,H-10,'MODELLED, NOT OBSERVED',
       {anchor:'middle',size:10.5,spacing:'0.06em'});
})();
</script>
